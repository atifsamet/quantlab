# OKX credentials are optional. Public candle endpoints work without keys.
# Never commit a filled .env. LIVE_TRADING_ENABLED must stay false.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# OKX REST base URL
OKX_BASE_URL=https://www.okx.com

# HTTP timeout in seconds
OKX_TIMEOUT_SECONDS=10.0

# Safety flags — keep disabled. This Phase 1 build cannot place trades.
TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false

# Logging
LOG_LEVEL=INFO
